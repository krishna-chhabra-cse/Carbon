{
  "manifest_version": 3,
  "name": "Carbon — AI Web Learning Companion",
  "version": "1.2.0",
  "description": "Your AI learning companion for the web. Deeply understand any webpage, concept, or codebase with instant explanations, learning modes, and visual intelligence.",
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus",
    "sidePanel",
    "scripting"
  ],
  "host_permissions": [
    "https://github.com/*",
    "http://localhost:3002/*",
    "http://localhost:5000/*",
    "http://localhost:8000/*",
    "https://*.vercel.app/*",
    "https://carbons.codes/*",
    "https://www.carbons.codes/*",
    "https://*.onrender.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Carbon — AI Learning Companion",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+C",
        "mac": "Command+Shift+C"
      },
      "description": "Open Carbon Learning Companion"
    }
  }
}
