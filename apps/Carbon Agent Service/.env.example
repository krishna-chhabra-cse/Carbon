# Carbon Agent Service (Roast + Go deeper). Copy to .env in this folder.

# [REQUIRED] Gemini key for the analysis agents.
GEMINI_API_KEY=your_gemini_key_here

# [REQUIRED IN PRODUCTION] Shared secret: the backend sends it as X-API-Key.
# Put the SAME value in the backend's CARBON_API_KEY. Make it long and random.
CARBON_API_KEY=
# Local dev only. Leave false (or unset) in production: the service then
# refuses every request that lacks the right CARBON_API_KEY.
CARBON_AUTH_DISABLED=false

# Only the backend calls this service, so browsers don't need access.
CORS_ORIGINS=http://localhost:5173

# Free cloud LLM fallbacks (optional; used when Gemini is out of quota).
GROQ_API_KEY=your_groq_key_here
CEREBRAS_API_KEY=your_cerebras_key_here
