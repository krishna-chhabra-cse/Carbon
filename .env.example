# ============================================================
# Carbon Environment Configuration Template
# ============================================================

# [REQUIRED] Google Gemini API Key for autonomous AI agents
GEMINI_API_KEY=your_gemini_api_key_here

# [OPTIONAL] Node.js Backend Port (default: 3002)
PORT=3002

# [REQUIRED FOR PROD] Internal/External URL to Python Agent Service
# - Local dev: http://localhost:8000
# - Docker Compose: http://agent-service:8000
# - Render Prod: https://your-agent-service.onrender.com
PYTHON_SERVICE_URL=http://localhost:8000

# [OPTIONAL] Allowed CORS Origins (comma-separated, default: *)
CORS_ORIGIN=*

# [OPTIONAL] Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=120
ANALYZE_RATE_LIMIT_MAX=30
