# ============================================================
# Carbon Environment Configuration Template
# ============================================================

# [REQUIRED] Google Gemini API Key for autonomous AI agents
GEMINI_API_KEY=your_gemini_api_key_here

# [OPTIONAL] Node.js Backend Port (default: 3002)
PORT=3002
# [REQUIRED FOR PROD] Turns off the local dev sign-in and locks CORS down.
NODE_ENV=production

# [REQUIRED FOR PROD] URL of the Python Agent Service (Roast + Go deeper)
# - Local dev: http://localhost:8005
# - Docker Compose: http://agent-service:8000
PYTHON_SERVICE_URL=http://localhost:8005
# Same value as CARBON_API_KEY on the agent service.
CARBON_API_KEY=

# Allowed site origins (comma-separated). Defaults: * in dev,
# https://carbons.codes + https://www.carbons.codes when NODE_ENV=production.
CORS_ORIGIN=https://carbons.codes,https://www.carbons.codes

# [OPTIONAL] Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=120
ANALYZE_RATE_LIMIT_MAX=30

# ── Launch videos (apps/Carbon Backend) ───────────────────────
# Where SQLite + rendered videos live. Mount this on a persistent volume.
DATA_DIR=/data
# GitHub token (no scopes needed) — raises the API limit from 60 to 5000 req/hour.
GITHUB_TOKEN=
# Gemini model for the storyboard "director" (falls back to gemini-flash-latest).
GEMINI_MODEL=
FRONTEND_URL=https://carbons.codes

# Sign-in (Supabase Auth). Same project as the frontend's VITE_SUPABASE_*.
# Without these nobody can sign in (the API fails closed).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Local dev only: "Continue as local dev user" on /login. Ignored when
# NODE_ENV=production and for requests that don't come from this machine.
AUTH_DEV_BYPASS=false

# Free tier
FREE_VIDEOS_PER_DAY=2
FREE_VIDEOS_PER_IP_PER_DAY=4

# Payments (Razorpay): NOT used at launch (no prices on the site). Leave empty.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Rendering
RENDER_CONCURRENCY=1
# CHROME_PATH=/usr/bin/chromium   # optional; otherwise Remotion's headless Chrome is used
