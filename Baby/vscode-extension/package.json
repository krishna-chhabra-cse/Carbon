{
  "name": "carbon-ai",
  "displayName": "Carbon — AI Architecture & Codebase Intelligence",
  "description": "Instant codebase intelligence in VS Code: interactive architecture flowcharts, component breakdown, and AI video explanations.",
  "version": "1.0.9",
  "publisher": "krishcarbon",
  "pricing": "Free",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/carbon-dev/carbon"
  },
  "bugs": {
    "url": "https://github.com/carbon-dev/carbon/issues"
  },
  "homepage": "https://carbons.codes",
  "keywords": [
    "ai",
    "architecture",
    "codebase",
    "flowchart",
    "mermaid",
    "intelligence",
    "explainer",
    "carbon"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "AI",
    "Education",
    "Programming Languages",
    "Visualization"
  ],
  "activationEvents": [
    "onCommand:carbon.explainWorkspace"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "carbon.explainWorkspace",
        "title": "Carbon: Explain Current Workspace",
        "category": "Carbon"
      }
    ],
    "configuration": {
      "title": "Carbon",
      "properties": {
        "carbon.backendUrl": {
          "type": "string",
          "default": "https://carbon-backend-a1sg.onrender.com",
          "description": "HTTPS URL of the live Carbon AI Cloud Backend on Render."
        },
        "carbon.llmProvider": {
          "type": "string",
          "enum": ["auto", "gemini", "ollama"],
          "default": "auto",
          "description": "AI Inference engine: 'auto' uses local Ollama if running with cloud fallback, 'ollama' forces 100% private offline inference, 'gemini' uses Google Gemini cloud."
        },
        "carbon.ollamaEndpoint": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Local Ollama server API endpoint URL."
        },
        "carbon.ollamaModel": {
          "type": "string",
          "default": "qwen2.5-coder",
          "description": "Name of local Ollama model to run (e.g. qwen2.5-coder, deepseek-r1, llama3.1, codellama)."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "package": "npx @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.4.0"
  },
  "license": "MIT"
}
