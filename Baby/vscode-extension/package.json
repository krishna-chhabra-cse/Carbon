{
  "name": "carbon-vscode",
  "displayName": "Carbon — AI Codebase Explainer & Video Synthesizer",
  "description": "Instant codebase intelligence in VS Code: interactive architecture flowcharts, component breakdown, and AI video explanations.",
  "version": "0.1.0",
  "publisher": "carbon-dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/carbon-dev/carbon"
  },
  "keywords": [
    "ai",
    "architecture",
    "mermaid",
    "codebase",
    "explainer",
    "scrimba",
    "gemini",
    "langgraph"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Education",
    "Programming Languages",
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "onCommand:carbon.explainWorkspace"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "carbon.explainWorkspace",
        "title": "Carbon: Explain Current Workspace",
        "category": "Carbon"
      }
    ],
    "configuration": {
      "title": "Carbon",
      "properties": {
        "carbon.backendUrl": {
          "type": "string",
          "default": "http://localhost:3002",
          "description": "HTTPS URL of your deployed Carbon Backend server (or http://localhost:3002 for local development)."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "package": "npx @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.4.0"
  }
}
