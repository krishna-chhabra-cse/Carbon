{
  "name": "carbon-vscode",
  "displayName": "Carbon",
  "description": "Explain the codebase currently open in VS Code using Carbon's AI analysis.",
  "version": "0.1.0",
  "publisher": "carbon-dev",
  "private": true,
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:carbon.explainWorkspace"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "carbon.explainWorkspace",
        "title": "Carbon: Explain Current Workspace"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.4.0"
  }
}
